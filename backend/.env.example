# SpendWise AI Backend Environment Configuration

# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./spendwise.db

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Service Configuration
# AI_PROVIDER can be 'mock' (default, offline, zero cost) or 'external' (optional when configured)
AI_PROVIDER=mock
# AI_API_KEY is optional - leave empty for mock / rule-based AI engine
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
